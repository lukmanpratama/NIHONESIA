{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nihongo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';f.readFile(p.join(process.cwd(),u),(e,d)=>{if(e){r.writeHead(404);return r.end('404')}r.writeHead(200,{'Content-Type':u.endsWith('.html')?'text/html; charset=utf-8':'text/plain; charset=utf-8'});r.end(d)})}).listen(8765)"],
      "port": 8765
    }
  ]
}
